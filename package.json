{
  "name": "@cogna8/openclaw-plugin",
  "version": "0.5.2",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "description": "Gate OpenClaw tool calls through Cogna8's action authority runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cogna8/openclaw-plugin.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "openclaw": "^2026.4.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "openclaw": "^2026.4.15",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.4.0",
      "minGatewayVersion": ">=2026.4.0"
    },
    "build": {
      "openclawVersion": "2026.4.15",
      "pluginSdkVersion": "2026.4.15"
    }
  }
}
